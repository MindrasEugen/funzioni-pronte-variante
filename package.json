{
  "type": "module",
  "name": "@mindraseugen/utility-kit",
  "version": "1.1.0",
  "description": "A lightweight JavaScript utility library for modern web development. Includes DOM manipulation, math operations, array utilities, string helpers, and general purpose functions. / Una libreria utility JavaScript leggera per lo sviluppo web moderno. Include manipolazione DOM, operazioni matematiche, utilità per array, helper per stringhe e funzioni di uso generale.",
  "main": "dist/utility-kit.js",
  "module": "dist/utility-kit.esm.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/utility-kit.js",
      "import": "./dist/utility-kit.esm.js"
    },
    "./dom": {
      "require": "./dist/dom/index.js",
      "import": "./dist/dom/index.esm.js"
    },
    "./math": {
      "require": "./dist/math/index.js",
      "import": "./dist/math/index.esm.js"
    },
    "./array": {
      "require": "./dist/array/index.js",
      "import": "./dist/array/index.esm.js"
    },
    "./string": {
      "require": "./dist/string/index.js",
      "import": "./dist/string/index.esm.js"
    },
    "./utils": {
      "require": "./dist/utils/index.js",
      "import": "./dist/utils/index.esm.js"
    },
    "./shortcuts": {
      "require": "./dist/shortcuts/index.js",
      "import": "./dist/shortcuts/index.esm.js"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "build:types": "tsc --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm run build:types",
    "dev": "npm run build -- --watch",
    "lint": "echo \"Linting...\""
  },
  "keywords": [
    "utility",
    "javascript",
    "dom",
    "math",
    "array",
    "string",
    "helper",
    "functions",
    "library",
    "web",
    "development",
    "lightweight",
    "esm",
    "commonjs"
  ],
  "author": "MindrasEugen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MindrasEugen/utility-kit.git"
  },
  "bugs": {
    "url": "https://github.com/MindrasEugen/utility-kit/issues"
  },
  "homepage": "https://github.com/MindrasEugen/utility-kit#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "jsdom": "^23.0.0",
    "rollup": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
